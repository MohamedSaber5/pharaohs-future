# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/pharaohs-future
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pharaohs-future?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_change_this_in_production
JWT_REFRESH_EXPIRES_IN=30d

# CORS - Frontend URL
CLIENT_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Bot Protection / CAPTCHA (Optional: Cloudflare Turnstile or Google reCAPTCHA)
# Leave blank to bypass or provide secret key to enforce verification on auth forms
# TURNSTILE_SECRET_KEY=0x4AAAAAAAx...
# RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
# CAPTCHA_STRICT=false

# Logging
LOG_LEVEL=info

# SMTP Email Configuration (Required for Password Reset OTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="مستقبل الفراعنة" <no-reply@pharaohsfuture.com>

# Initial Admin Creation (create-admin.mjs)
ADMIN_NAME="System Admin"
ADMIN_EMAIL="admin@pharaohsfuture.com"
ADMIN_PASSWORD="ChangeMeInProduction123!"
ADMIN_PHONE="+201000000000"
